#!/usr/bin/env bash
set -euo pipefail
# Future owner-approved Ubuntu 24.04 instance only. This script was not run on AWS.
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io
systemctl enable --now docker
mkdir -p /opt/final-devops-data
chown 10001:10001 /opt/final-devops-data
docker run -d --restart unless-stopped --name final-devops -p 80:8080 \
  -v /opt/final-devops-data:/data -e APP_MESSAGE='Final DevOps cloud application' \
  '${image}'
